---
/**
 * 工具分类页 /tools
 * 不需要极致简化：按功能分类分组，展示全部工具，支持侧边分类导航。
 */

import '../styles/global.css';

// 全量工具数据：按类别分组
const categories = [
  {
    id: "format",
    name: "格式处理",
    desc: "数据格式的美化、校验与转换",
    tools: [
      { icon: "📝", name: "JSON 格式化", desc: "轻量级 JSON 校验与美化", href: "/tools/json" },
      { icon: "🔐", name: "Base64 编解码", desc: "文本与 Base64 快速转换", href: "/tools/base64" },
      { icon: "🔍", name: "正则表达式", desc: "实时测试与调试正则", href: "/tools/regex" },
      { icon: "📄", name: "URL 编解码", desc: "URL 参数编码与解析", href: "/tools/url" },
    ],
  },
  {
    id: "time",
    name: "时间与日期",
    desc: "时间戳、时区、日期格式互转",
    tools: [
      { icon: "⏱️", name: "时间戳转换", desc: "毫秒/秒级时间戳互转", href: "/tools/timestamp" },
      { icon: "📅", name: "Cron 表达式", desc: "Cron 解析与可视化", href: "/tools/cron" },
    ],
  },
  {
    id: "color",
    name: "设计与图像",
    desc: "颜色、图形与编码相关工具",
    tools: [
      { icon: "🎨", name: "颜色拾取器", desc: "HEX/RGB/HSL 颜色转换", href: "/tools/color" },
      { icon: "🔲", name: "二维码生成", desc: "输入文本即刻生成二维码", href: "/tools/qrcode" },
      { icon: "🖼️", name: "图片压缩", desc: "在线无损/有损压缩图片", href: "/tools/img-compress" },
    ],
  },
  {
    id: "dev",
    name: "开发辅助",
    desc: "面向开发者的实用小工具",
    tools: [
      { icon: "🔑", name: "UUID 生成器", desc: "批量生成唯一标识符", href: "/tools/uuid" },
      { icon: "🧮", name: "进制转换", desc: "二进制/十进制/十六进制互转", href: "/tools/radix" },
      { icon: "📊", name: "哈希计算", desc: "MD5/SHA1/SHA256 摘要", href: "/tools/hash" },
      { icon: "🧬", name: "SQL 格式化", desc: "SQL 语句美化与压缩", href: "/tools/sql" },
    ],
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="looptool - 全部在线工具分类索引" />
    <title>工具集 · looptool</title>
  </head>
  <body>
    <!-- ========== 导航栏 ========== -->
    <header class="site-header">
      <nav class="nav-container">
        <a href="/" class="logo">looptool</a>
        <div class="nav-links">
          <a href="/tools" class="active">工具集</a>
          <a href="/about">关于</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- ========== 页面标题 ========== -->
      <section class="page-head">
        <h1>工具集</h1>
        <p class="page-desc">按功能分类浏览全部工具，所有处理均在本地完成。</p>
      </section>

      <div class="layout">
        <!-- ========== 侧边分类导航 ========== -->
        <aside class="sidebar">
          <div class="sidebar-title">分类</div>
          <ul class="cat-nav">
            {categories.map((cat) => (
              <li>
                <a href={`#${cat.id}`}>{cat.name}</a>
              </li>
            ))}
          </ul>
        </aside>

        <!-- ========== 分类工具列表 ========== -->
        <div class="cat-content">
          {categories.map((cat) => (
            <section class="cat-group" id={cat.id}>
              <h2 class="cat-name">{cat.name}</h2>
              <p class="cat-desc">{cat.desc}</p>
              <div class="tools-grid">
                {cat.tools.map((tool) => (
                  <a href={tool.href} class="tool-card">
                    <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
                    <div class="tool-text">
                      <span class="tool-name">{tool.name}</span>
                      <span class="tool-desc">{tool.desc}</span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </main>

    <!-- ========== 页脚 ========== -->
    <footer class="site-footer">
      <div class="footer-container">
        <span class="copyright">© 2026 looptool.</span>
        <a href="https://github.com" class="github-link" target="_blank" rel="noopener noreferrer">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405s2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </footer>

    <style>
      /* ---------- 基础重置 ---------- */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        scroll-behavior: smooth; /* 侧边导航锚点平滑滚动 */
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #ffffff;
        color: #1a1a1a;
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .nav-container,
      .page-head,
      .layout,
      .footer-container {
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ---------- 导航栏 ---------- */
      .site-header {
        border-bottom: 1px solid #eaeaea;
        padding: 1.25rem 0;
      }

      .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        gap: 1.75rem;
      }

      .nav-links a {
        font-size: 0.95rem;
        color: #666666;
        transition: color 0.15s ease;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: #1a1a1a;
      }

      /* ---------- 页面标题 ---------- */
      .page-head {
        margin-top: 4rem;
        margin-bottom: 2.5rem;
      }

      .page-head h1 {
        font-size: 2.25rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
      }

      .page-desc {
        font-size: 1rem;
        color: #666666;
      }

      /* ---------- 布局：侧边栏 + 内容 ---------- */
      .layout {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 3rem;
        margin-bottom: 6rem;
      }

      /* ---------- 侧边分类导航 ---------- */
      .sidebar {
        position: sticky;
        top: 2rem;
        align-self: start;
      }

      .sidebar-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #666666;
        margin-bottom: 0.75rem;
      }

      .cat-nav {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        border-left: 1px solid #eaeaea;
        padding-left: 1rem;
      }

      .cat-nav a {
        display: block;
        padding: 0.4rem 0;
        font-size: 0.95rem;
        color: #666666;
        transition: color 0.15s ease;
      }

      .cat-nav a:hover {
        color: #2563eb;
      }

      /* ---------- 分类工具列表 ---------- */
      .cat-group {
        margin-bottom: 3rem;
        scroll-margin-top: 2rem; /* 锚点跳转留出顶部间距 */
      }

      .cat-name {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
      }

      .cat-desc {
        font-size: 0.9rem;
        color: #666666;
        margin-bottom: 1.25rem;
      }

      .tools-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(2, 1fr);
      }

      /* 工具卡片：横向布局（图标 + 文字） */
      .tool-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem;
        background: #ffffff;
        border: 1px solid #eaeaea;
        border-radius: 8px;
        transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
      }

      .tool-card:hover {
        border-color: #000000;
        background: #f9f9f9;
        transform: translateY(-1px);
      }

      .tool-icon {
        font-size: 1.75rem;
        line-height: 1;
        flex-shrink: 0;
      }

      .tool-text {
        display: flex;
        flex-direction: column;
      }

      .tool-name {
        font-size: 1rem;
        font-weight: 600;
        color: #1a1a1a;
      }

      .tool-desc {
        font-size: 0.85rem;
        color: #666666;
      }

      /* ---------- 页脚 ---------- */
      .site-footer {
        margin-top: auto;
        border-top: 1px solid #eaeaea;
        padding: 1.5rem 0;
      }

      .footer-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.875rem;
        color: #666666;
      }

      .github-link {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: #666666;
        transition: color 0.15s ease;
      }

      .github-link:hover {
        color: #1a1a1a;
      }

      /* ---------- 响应式 ---------- */
      @media (max-width: 800px) {
        .layout {
          grid-template-columns: 1fr; /* 小屏：侧边栏移到顶部 */
          gap: 2rem;
        }

        .sidebar {
          position: static;
        }

        .cat-nav {
          flex-direction: row;
          flex-wrap: wrap;
          border-left: none;
          border-bottom: 1px solid #eaeaea;
          padding-left: 0;
          padding-bottom: 0.75rem;
        }

        .tools-grid {
          grid-template-columns: 1fr; /* 小屏单列 */
        }

        .page-head {
          margin-top: 3rem;
        }

        .nav-container,
        .page-head,
        .layout,
        .footer-container {
          padding: 0 1rem;
        }

        .footer-container {
          flex-direction: column;
          gap: 0.75rem;
          text-align: center;
        }
      }
    </style>
  </body>
</html>