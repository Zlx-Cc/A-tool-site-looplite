---
// 这是 frontmatter，服务端/构建时运行，不会进浏览器
const title = "A-Tool Site";
const tools = [
  { name: "Markdown", desc: "轻量标记语言" },
  { name: "Timer",    desc: "专注计时器" },
  { name: "Notes",    desc: "快速笔记" },
];
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>欢迎来到 {title} 👋</h1>
      <p>这是一个用 Astro 搭建的简单工具站。</p>

      <ul class="tools">
        {tools.map((t) => (
          <li>
            <strong>{t.name}</strong>: {t.desc}
          </li>
        ))}
      </ul>
    </main>

    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 640px;
        margin: 2rem auto;
        padding: 0 1rem;
        color: #222;
      }
      h1 { color: #0d6efd; }
      .tools { line-height: 1.8; }
    </style>
  </body>
</html>
